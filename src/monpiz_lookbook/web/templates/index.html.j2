{% import "macros.j2" as m with context %}
{% import "pages.j2" as pages_ with context %}
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ lb.meta.title }}</title>
<meta name="description" content="{{ lb.cover.claim }}">
<meta name="theme-color" content="{{ colors.paper }}">
{% if lb.web.url %}<link rel="canonical" href="{{ lb.web.url }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:title" content="{{ lb.meta.title }}">
<meta property="og:description" content="{{ lb.cover.claim }}">
<meta property="og:image" content="{{ share }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% if lb.web.url %}<meta property="og:url" content="{{ lb.web.url }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ icons['favicon-32.png'] }}" sizes="32x32">
<link rel="icon" href="{{ icons['icon-192.png'] }}" sizes="192x192">
<link rel="apple-touch-icon" href="{{ icons['apple-touch-icon.png'] }}">
{% for f in fonts %}
<link rel="preload" href="{{ f.url }}" as="font" type="font/{{ f.format }}" crossorigin>
{% endfor %}
<style>
{% for f in fonts %}
@font-face { font-family: "{{ f.family }}"; src: url("{{ f.url }}") format("{{ f.format }}"); font-display: swap; }
{% endfor %}
:root {
{% for name, value in colors.items() %}  --{{ name }}: {{ value }};
{% endfor %}  --ridge-clip: {{ ridge_clip }};
  --ridge-clip-wide: {{ ridge_clip_wide }};
}
</style>
<link rel="stylesheet" href="{{ static['site.css'] }}">
<script src="{{ static['site.js'] }}" defer></script>
</head>
<body>
<div class="progress" aria-hidden="true"><span data-progress></span></div>

<main class="book" aria-label="{{ lb.meta.title }}">
{% for page in pages %}
  <section class="page page--{{ page.kind }}" id="{{ page.id }}" data-page="{{ page.number }}"
           aria-label="Pagina {{ page.number }}{% if page.title %}: {{ page.title }}{% endif %}">
    <div class="sheet">
      {{ pages_[page.kind](page) }}
    </div>
  </section>
{% endfor %}
</main>

<nav class="dock" aria-label="Pagine">
  <button type="button" class="dock__turn" data-prev aria-label="Pagina precedente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
  <button type="button" class="dock__count" data-overview-toggle aria-expanded="false" aria-controls="overview">
    <span data-count>1</span><span class="dock__total"> / {{ total }}</span><span class="dock__label">Pagine</span>
  </button>
  <button type="button" class="dock__turn" data-next aria-label="Pagina successiva"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
</nav>

<div class="overview" id="overview" hidden data-overview role="dialog" aria-modal="true" aria-label="Tutte le pagine">
  <div class="overview__head">
    {{ m.img(logo, lb.meta.author, "120px", cls="overview__logo") }}
    <button type="button" class="overview__close" data-overview-close>Chiudi</button>
  </div>
  <ol class="overview__grid">
    {% for page in pages %}
    <li>
      <a class="thumb" href="#{{ page.id }}" data-goto>
        {% if page.thumb %}{{ m.img(pic(page.thumb, widths=(320,), ratio=0.75), "", "(orientation: landscape) 12vw, 30vw") }}
        {% else %}<span class="thumb__paper">{{ page.title }}</span>{% endif %}
        <span class="thumb__caption"><b>{{ page.number }}</b> {{ page.title }}</span>
      </a>
    </li>
    {% endfor %}
  </ol>
</div>
</body>
</html>
