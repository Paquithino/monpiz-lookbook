{# One macro per page kind (see book.py). `page` is a book.Page. #}
{% import "macros.j2" as m with context %}

{% macro folio(page) -%}
<header class="folio">
  <span class="folio__head">{{ page.section }}{% if page.kind != "contents" %}<a class="folio__index" href="#indice" data-goto>{{ _("Indice") }}</a>{% endif %}</span>
  <span>{{ page.number }}</span>
</header>
{%- endmacro %}

{% macro cover(page) -%}
{% set c = lb.cover %}
{% if c.banner %}
<div class="cover__top">
  <div class="cover__banner">{{ m.img(pic(c.banner), "", "100vw", eager=True) }}</div>
  <svg class="cover__ridge" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="ridge--phone" d="{{ ridge_path }}" vector-effect="non-scaling-stroke"/>
    <path class="ridge--wide" d="{{ ridge_path_wide }}" vector-effect="non-scaling-stroke"/>
  </svg>
</div>
{% endif %}
{% if editions|length > 1 %}
<nav class="langs langs--cover" aria-label="{{ _("Lingua") }}">
  {% for e in editions %}<a href="{{ e.file }}" hreflang="{{ e.lang }}" lang="{{ e.lang }}" title="{{ e.name }}" data-lang-switch{% if e.lang == edition.lang %} aria-current="true"{% endif %}>{{ e.label }}</a>{% endfor %}
</nav>
{% endif %}
<div class="cover__body">
  <h1 class="cover__logo">{{ m.img(logo, lb.meta.author, "(min-width: 960px) 260px, 46vw", eager=True) }}</h1>
  <p class="cover__tagline">{{ c.tagline }}</p>
  <div class="cover__boots">{{ m.img(boots, "", "(min-width: 960px) 600px, 80vw", eager=True) }}</div>
  <p class="cover__claim">{{ c.claim }}</p>
  {% if c.highlights %}<ul class="cover__highlights">{% for h in c.highlights %}<li>{{ h | e | replace(" Italy", "<br>Italy" | safe) }}</li>{% endfor %}</ul>{% endif %}
  <a class="cover__hint" href="#marchio" data-goto>{{ _("Scorri per sfogliare") }}</a>
</div>
{%- endmacro %}

{% macro brand(page) -%}
{% set b = lb.brand %}
{{ folio(page) }}
<div class="text-block">
  <h2 class="title">{{ b.title }}</h2>
  {% for paragraph in b.paragraphs %}<p class="lead">{{ paragraph }}</p>{% endfor %}
</div>
<figure class="wide">{{ m.img(pic(b.banner.path), "", "(min-width: 960px) 920px, 100vw") }}</figure>
{%- endmacro %}

{% macro details(page) -%}
{% set b = lb.brand %}
{{ folio(page) }}
<h2 class="title">{{ b.details_title }}</h2>
<ul class="details">
  {% for d in b.details %}
  <li>
    {{ m.img(pic(d.image, widths=SMALL, ratio=1.0), "", "(min-width: 960px) 200px, 40vw") }}
    <h3>{{ d.name }}</h3>
    <p>{{ d.description }}</p>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{% macro contents(page) -%}
{# As in print: the list on the left, one entry under the other, the photo on the right. #}
<div class="contents">
  <div class="contents__list">
    {{ folio(page) }}
    <h2 class="title">{{ page.title }}</h2>
    <ol class="toc">
      {% for entry in menu %}
      <li>
        <a class="toc__entry" href="#{{ entry.anchor }}" data-goto><span>{{ entry.title }}</span><span class="toc__page">{{ page_number[entry.anchor] }}</span></a>
        {% if entry.children %}
        <ol class="toc__children">
          {% for child in entry.children %}<li><a href="#{{ child.anchor }}" data-goto><span>{{ child.title }}</span><span class="toc__page">{{ page_number[child.anchor] }}</span></a></li>{% endfor %}
        </ol>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
  {% if page.thumb %}<figure class="contents__photo">{{ m.img(pic(page.thumb), "", "(min-width: 960px) 360px, 40vw") }}</figure>{% endif %}
</div>
{%- endmacro %}

{% macro photo(page) -%}
<figure class="wide wide--photo">{{ m.img(pic(page.data.photo), "", "(min-width: 960px) 920px, 100vw") }}</figure>
{%- endmacro %}

{% macro opener(page) -%}
{% set s = page.data.section %}
{% if s.photo %}<figure class="bleed">{{ m.img(pic(s.photo), "", "(min-width: 960px) 920px, 100vw") }}</figure>{% endif %}
<div class="opener__text">
  <p class="opener__number">{{ "%02d" % page.data.number }}<span>{{ s.eyebrow }}</span></p>
  <h2 class="opener__name">{{ s.name }}</h2>
  {% if s.intro %}<p class="opener__intro">{{ s.intro }}</p>{% endif %}
  <p class="opener__count">{{ models_label(s.models|length) }}</p>
</div>
{%- endmacro %}

{% macro model(page) -%}
{% set mo = page.data.model %}
{{ folio(page) }}
<figure class="wide model__hero">
  {% if mo.image %}{{ m.img(pic(mo.image), mo.name, "(min-width: 960px) 920px, 100vw") }}{% else %}{{ m.placeholder() }}{% endif %}
</figure>
<div class="model__text">
  <p class="kicker">{{ page.data.section.name }}, {{ _("modello %d di %d") % (page.data.index, page.data.count) }}</p>
  <h2 class="model__name">{{ mo.name }}</h2>
  <p class="body">{{ mo.description }}</p>
  {% if mo.specs %}<dl class="specs specs--inline">{% for s in mo.specs %}<div><dt>{{ s.label }}</dt><dd>{{ s.value }}</dd></div>{% endfor %}</dl>{% endif %}
  {% if mo.materials %}
  {% set ratio = material_ratio(mo.materials|length) %}
  <p class="materials__label">{{ _("Materiali") }}</p>
  <ol class="materials" aria-label="{{ _("Materiali") }}" style="--count: {{ mo.materials|length }}; --ratio: {{ '%.3f' % ratio }}">
    {% for mat in mo.materials %}
    <li>
      {% if mat.image %}{{ m.img(pic(mat.image, widths=SMALL, ratio=ratio), "", "(min-width: 960px) 210px, 26vw") }}
      {% else %}<span class="materials__empty" aria-hidden="true"></span>{% endif %}
      <span class="materials__name">{{ mat.name }}</span>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</div>
{%- endmacro %}

{% macro feature(page) -%}
{% set f = page.data.feature %}
<figure class="bleed">{{ m.img(pic(f.image), "", "(min-width: 960px) 920px, 100vw", style="object-position: %d%% %d%%" % (f.focus_x * 100, f.focus_y * 100)) }}</figure>
<div class="feature__text">
  <p class="feature__label">{{ f.label }}</p>
  <h3 class="feature__title">{{ f.title }}</h3>
  {% if f.text %}<p class="feature__body">{{ f.text }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro product(page) -%}
{% set p = page.data.product %}
{% set mo = page.data.model %}
{{ folio(page) }}
<div class="wide shots shots--{{ p.variants|length }}{% if p.closeup %} shots--closeup{% endif %}">
  {% for v in p.variants %}
  <figure class="shot">
    {{ m.studio(v.image, p.name ~ ", " ~ v.color, "100vw") }}
    <figcaption>{{ v.color }}</figcaption>
  </figure>
  {% endfor %}
  {% if p.closeup %}
  <figure class="closeup">
    {{ m.img(pic(p.closeup.image, widths=(480, 800)), p.closeup.label, "(min-width: 960px) 340px, 37vw") }}
    <figcaption>{{ p.closeup.label }}</figcaption>
  </figure>
  {% endif %}
</div>
<div class="product__text">
  <p class="kicker">{{ mo.name }}</p>
  {% set variant = short_name(p.name, mo.name) %}
  <h3 class="product__name{% if variant != p.name %} product__name--variant{% endif %}">{{ variant }}</h3>
  <p class="body">{{ p.description }}</p>
  <dl class="specs specs--inline">
    {% for s in p.specs %}<div><dt>{{ s.label }}</dt><dd>{{ s.value }}</dd></div>{% endfor %}
    {% if p.sizes %}<div><dt>{{ _("Taglie") }}</dt><dd>{{ p.sizes }}</dd></div>{% endif %}
    {% if p.colors %}<div><dt>{{ _("Colori") }}</dt><dd>{{ p.colors|length }}</dd></div>{% endif %}
  </dl>
  {% if p.colors %}
  <div class="colors">
    <p class="colors__label">{{ _("Colori") }}</p>
    <ul class="colors__chips">
      {% for c in p.colors %}
      {% set shown = c.name|trim|lower == p.master.color|trim|lower %}
      <li>
        {# Not clickable: the ring marks the colour of the shoe in the photo, as in print. #}
        <span class="chip{% if shown %} is-current{% endif %}" aria-hidden="true">
          {% if c.image %}{{ m.img(pic(c.image, widths=(160,), ratio=1.0), "", "48px") }}{% endif %}
        </span>
        <span class="chip__name">{{ c.name }}{% if shown %}<span class="visually-hidden"> {{ _("(in foto)") }}</span>{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
{%- endmacro %}

{% macro retailers_map(page) -%}
{% set r = page.data.retailers %}
{{ folio(page) }}
<h2 class="title">{{ r.title }}</h2>
{% if r.intro %}<p class="body">{{ r.intro }}</p>{% endif %}
{% if map %}
<figure class="map">
  <svg viewBox="0 0 {{ map.width }} {{ map.height }}" role="img" aria-label="{{ _("Mappa dei rivenditori") }}" preserveAspectRatio="xMidYMid meet">
    <path class="map__sky" d="{{ map.skyline }}"/>
    {% for d in map.dots %}
    {% if d.stores|length == 1 %}{% set s = d.stores[0] %}
    <a class="map__dot" href="{{ s.link }}" target="_blank" rel="noopener" aria-label="{{ s.name }}, {{ s.town }}"><title>{{ s.name }}, {{ s.town }}</title><circle r="6" cx="{{ '%.1f' % d.x }}" cy="{{ '%.1f' % d.y }}"/></a>
    {% else %}
    <a class="map__dot map__dot--group" href="#{{ store_id(d.stores[0]) }}" data-goto aria-label="{{ _("%d negozi") % d.stores|length }}: {{ d.stores|map(attribute='name')|join(', ') }}"><title>{{ d.stores|map(attribute='name')|join(', ') }}</title><circle r="11" cx="{{ '%.1f' % d.x }}" cy="{{ '%.1f' % d.y }}"/><text x="{{ '%.1f' % d.x }}" y="{{ '%.1f' % d.y }}">{{ d.stores|length }}</text></a>
    {% endif %}
    {% endfor %}
    {% for label in map.cities %}<text class="map__city" x="{{ '%.1f' % label.x }}" y="{{ '%.1f' % label.y }}" text-anchor="{{ label.anchor }}">{{ label.text }}</text>{% endfor %}
  </svg>
  {% if map.outside %}<figcaption>{{ _("Anche in: ") }}{{ map.outside | join(", ") }}</figcaption>{% endif %}
</figure>
{% endif %}
<p class="map__hint">{{ _("Tocca un punto per aprire il negozio; i numeri raccolgono i negozi vicini. L'elenco completo è qui sotto.") }}</p>
{%- endmacro %}

{% macro retailers_list(page) -%}
{{ folio(page) }}
{% for chunk in page.data.chunks %}
<section class="region">
  <h3 class="region__name">{{ chunk.region.region }}{% if chunk.continued %} <span>{{ _("(segue)") }}</span>{% endif %}</h3>
  <ul>
    {% for s in chunk.stores %}
    <li class="store{% if s.shop %} store--shop{% endif %}" id="{{ store_id(s) }}">
      <a class="store__name" href="{{ s.link }}" target="_blank" rel="noopener">{{ s.name }}</a>
      <span class="store__town">{{ s.town }}</span>
      <span class="store__links">
        <a href="{{ s.maps_url }}" target="_blank" rel="noopener">{{ _("Mappa") }}</a>
        {% if s.phone %}<a href="{{ phone_href(s.phone) }}">{{ s.phone }}</a>{% endif %}
      </span>
      {% if s.shop %}<a class="store__shop" href="{{ s.shop }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>{{ _("Acquista online") }}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
{%- endmacro %}

{% macro closing(page) -%}
{% set c = lb.closing %}
<div class="closing__body">
  <h2 class="closing__title">{{ c.title }}</h2>
  {{ m.img(logo, lb.meta.author, "200px", cls="closing__logo") }}
  <p class="body">{{ c.text }}</p>
  {% set icons = {
    "email": '<path d="M3.5 6.5h17v11h-17z"/><path d="M3.5 7l8.5 6.5L20.5 7"/>',
    "phone": '<path d="M6.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/>',
    "web": '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 3.8 5.2 3.8 8.5s-1.2 6.1-3.8 8.5c-2.6-2.4-3.8-5.2-3.8-8.5s1.2-6.1 3.8-8.5z"/>',
    "instagram": '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>',
  } %}
  <ul class="contacts">
    {% for k in contacts %}
    <li class="contact contact--{{ k.kind }}">
      {% if k.href %}<a href="{{ k.href }}"{% if k.href.startswith("http") %} target="_blank" rel="noopener"{% endif %}>{% else %}<span>{% endif %}
        {% if k.kind in icons %}<svg viewBox="0 0 24 24" aria-hidden="true">{{ icons[k.kind] | safe }}</svg>{% endif %}
        <span class="contact__text">
          {% if k.label %}<span class="contact__label">{% if k.kind == "instagram" %}{{ _("Seguici su Instagram") }}{% else %}{{ k.label }}{% endif %}</span>{% endif %}
          <span class="contact__value">{{ k.text }}</span>
        </span>
      {% if k.href %}</a>{% else %}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  <p class="closing__legal">© {{ year }} {{ lb.meta.author }}</p>
</div>
{%- endmacro %}
